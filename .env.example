# ==============================================================================
# Invoice BizFolio — Environment Variables Template
# Copy to .env.local for local development. NEVER commit .env.local to version control.
# Production runs on Render: set these in Render → Environment (see docs/LAUNCH_CHECKLIST.md section 4).
# ==============================================================================

# ── App & Contact ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required in production (the server refuses to start without it). Shown on legal pages, checkout and settings.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
FEEDBACK_RECIPIENT_EMAIL=support@example.com

# ── Database (Neon Serverless Postgres) ──
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Auth (Neon Auth) ──
NEON_AUTH_BASE_URL=https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
# Generate with: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=replace-with-64-char-hex-secret-at-least-32-bytes-long

# ── Object Storage (iDrive e2 — S3-compatible) & PDF Rendering ──
IDRIVE_E2_ENDPOINT=https://s3.ap-southeast-1.idrivee2.com
IDRIVE_E2_REGION=ap-southeast-1
IDRIVE_E2_BUCKET_NAME=bizfolio-prod-files
IDRIVE_E2_ACCESS_KEY=replace-with-idrive-access-key
IDRIVE_E2_SECRET_KEY=replace-with-idrive-secret-key
HTML_TO_PDF_API_KEY=replace-with-html-to-pdf-api-key

# ── Transactional Email (Brevo web API — not SMTP: Render Free blocks e-mail ports) ──
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_FROM="Invoice BizFolio <invoices@yourdomain.com>"

# ── Rate Limiting (Upstash Redis) ──
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# ── Internal Security & Cron Jobs ──
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-64-char-hex-secret

# ── Platform Admin & Manual Subscription Settlement Details ──
# auth user ids of platform admins, comma-separated; preferred over e-mails
PLATFORM_ADMIN_USER_IDS=
# Comma-separated list of platform administrator emails (fallback; honoured ONLY for verified e-mails)
PLATFORM_ADMIN_EMAILS=admin@yourdomain.com
ADMIN_UPI_ID=merchant@upi
ADMIN_UPI_NAME=Invoice BizFolio
ADMIN_BANK_NAME=State Bank of India
ADMIN_BANK_ACC_NAME=Your Business Name
ADMIN_BANK_ACC_NO=00000000000
ADMIN_BANK_IFSC=SBIN0000000

# ── Sentry (Error Monitoring) ──
# Server DSN (preferred for nodejs and edge runtimes; kept private on server)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Browser DSN (publicly exposed; also feeds the CSP report URI; keep it the same project as SENTRY_DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Build-time source map upload credentials (withSentryConfig in next.config.mjs)
SENTRY_AUTH_TOKEN=sntrys_replace_me
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# Environment name shown in Sentry: "test" while testing, "production" after the switch (docs/LAUNCH_CHECKLIST.md 7.3).
# Read at BUILD time, so change it and redeploy. Falls back to VERCEL_ENV, then NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Release name: taken automatically from RENDER_GIT_COMMIT (Render) or VERCEL_GIT_COMMIT_SHA (Vercel).

# ── Build & CI Bypass ──
# SKIP_ENV_VALIDATION=1  # local/CI builds only; ignored on Vercel production and on every Render service

# ── Real Database Integration Tests (TEST-002) ──
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/bm_test
# TEST_DATABASE_IS_DISPOSABLE=1   # required for any non-local (e.g. Neon branch) test database

# ── End-to-End Tests (TEST-003; app built and started on the CI runner since LAUNCH-L5) ──
# E2E_BASE_URL=http://localhost:3000
# E2E_CONFIRM_STAGING=yes-this-is-not-production
# E2E_FORBIDDEN_HOSTS=your-app.onrender.com
# E2E_DATABASE_URL=postgresql://user:pass@ep-staging.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# E2E_DB_HOST_ALLOWLIST=ep-staging.ap-southeast-1.aws.neon.tech
# E2E_FORBIDDEN_DB_HOSTS=ep-prod.ap-southeast-1.aws.neon.tech,ep-prod-pooler.ap-southeast-1.aws.neon.tech
# E2E_VERIFY_MODE=db
# E2E_EXPECT_VERIFICATION_REQUIRED=true
# E2E_ADMIN_EMAIL=e2e-admin@bizfolio.test
# E2E_ADMIN_PASSWORD=replace-with-e2e-admin-password
# E2E_UPSTASH_REST_URL=https://staging-redis.upstash.io
# E2E_UPSTASH_REST_TOKEN=replace-with-staging-upstash-token
# E2E_UPSTASH_ALLOW_FLUSH=false
# E2E_UPSTASH_HOST_ALLOWLIST=staging-redis.upstash.io
# E2E_UPDATE_A11Y_BASELINE=false
# E2E_STAGING_DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-staging.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

