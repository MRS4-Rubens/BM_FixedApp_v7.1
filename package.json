{
  "name": "bill-matrix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local lib/db/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:realdb": "vitest run --config vitest.realdb.config.mts",
    "test:realdb:watch": "vitest --config vitest.realdb.config.mts",
    "test:watch": "vitest",
    "db:check": "drizzle-kit check",
    "lint:ratchet": "tsx scripts/ci/lint-ratchet.ts",
    "print-css:build": "tsx scripts/build-print-css.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:list": "playwright test --list",
    "e2e:report": "playwright show-report",
    "e2e:migrate-staging": "tsx scripts/ci/migrate-staging.ts",
    "perf:export-benchmark": "tsx scripts/perf/export-benchmark.ts",
    "verify": "pnpm typecheck && pnpm lint:ratchet && pnpm db:check && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/auth": "0.4.2-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.78.0",
    "@tanstack/react-query": "^5.101.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.5",
    "qrcode": "1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "postcss": "^8.5",
    "shadcn": "4.10.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.12"
  }
}
