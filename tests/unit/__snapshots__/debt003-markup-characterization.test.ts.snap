exports[`DEBT-003 Markup Characterization Snapshot > CheckoutForm (h) pendingRequest present ("Payment Claim Under Review" screen) 1`] = `"<div class="mx-auto max-w-5xl rounded-2xl border border-amber-200/90 bg-white p-5 sm:p-7 shadow-md"><div class="flex flex-col items-center text-center space-y-3.5"><div class="size-13 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 border border-amber-200 shadow-2xs"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock size-6 animate-pulse" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg></div><div><span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-3 py-0.5 text-xs font-bold text-amber-800 mb-1.5">Verification In Progress</span><h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 font-heading">Payment Claim Under Review</h2><div class="mt-1.5 text-xs sm:text-sm text-slate-600 leading-relaxed text-center space-y-0.5"><p class="block">Your transaction reference has been logged. Our super administrators are verifying the bank statement.</p><p class="block">Your subscription will activate automatically upon approval.</p></div></div><div class="w-full max-w-2xl py-3 border-y border-slate-100 my-1"><div class="flex items-center justify-between text-xs"><div class="flex flex-col items-center gap-1 text-center shrink-0"><span class="size-6 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs shadow-2xs"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="font-bold text-xs sm:text-sm text-slate-900 whitespace-nowrap">Claim Logged</span><span class="text-[11px] text-slate-500 whitespace-nowrap">03:30 pm</span></div><div class="h-0.5 flex-1 bg-amber-300 mx-3 sm:mx-6"></div><div class="flex flex-col items-center gap-1 text-center shrink-0"><span class="size-6 rounded-full bg-amber-700 text-white flex items-center justify-center font-bold text-xs shadow-2xs">2</span><span class="font-bold text-xs sm:text-sm text-amber-800 whitespace-nowrap">Bank Reconciliation</span><span class="text-[11px] text-slate-600 whitespace-nowrap">In progress</span></div><div class="h-0.5 flex-1 bg-slate-200 mx-3 sm:mx-6"></div><div class="flex flex-col items-center gap-1 text-center shrink-0"><span class="size-6 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-xs">3</span><span class="font-bold text-xs sm:text-sm text-slate-600 whitespace-nowrap">Activation</span><span class="text-[11px] text-slate-600 whitespace-nowrap">Instant</span></div></div></div><div class="w-full rounded-xl bg-slate-50 border border-slate-200/90 overflow-hidden shadow-2xs"><div class="grid grid-cols-1 md:grid-cols-[1.35fr_0.85fr_1.1fr] divide-y md:divide-y-0 md:divide-x divide-slate-200 text-xs sm:text-sm"><div class="px-4 py-2.5 flex items-center justify-center gap-1.5 text-center whitespace-nowrap"><span class="text-slate-500 font-medium shrink-0">Selected Plan:</span><span class="font-bold text-slate-900 capitalize shrink-0">Essentials Pro (yearly)</span></div><div class="px-4 py-2.5 flex items-center justify-center gap-1.5 text-center whitespace-nowrap"><span class="text-slate-500 font-medium shrink-0">Claimed Amount:</span><span class="font-black text-slate-900 font-heading shrink-0">₹4,990.00</span></div><div class="px-4 py-2.5 flex items-center justify-center gap-1.5 text-center whitespace-nowrap"><span class="text-slate-500 font-medium shrink-0">Claimed UTR / Ref:</span><span class="font-mono font-bold text-indigo-700 shrink-0">123456789012</span></div></div></div><p class="text-xs text-slate-500 whitespace-nowrap text-center">Verification typically takes 15–30 minutes during standard business hours. Feel free to continue using your account in the meantime.</p><div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto pt-1"><button type="button" tabindex="0" data-slot="button" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border bg-clip-padding whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 bg-background hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 font-bold text-sm cursor-pointer h-9.5 px-5 border-slate-200">Back to Dashboard</button><a href="/settings?tab=Billing &amp; Usage"><button type="button" tabindex="0" data-slot="button" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [a]:hover:bg-primary/80 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 w-full sm:w-auto font-bold text-sm cursor-pointer h-9.5 px-5 bg-indigo-600 hover:bg-indigo-700 text-white shadow-2xs">View Billing Settings</button></a></div></div></div>"`;

exports[`DEBT-003 Markup Characterization Snapshot > InvoiceForm (a) new invoice, exclusive GST, intra-state, fixed invoice_date 2026-06-15 1`] = `"<div class="space-y-4"><div class="space-y-3.5 print:hidden"><div class="flex items-center gap-3"><a aria-label="Back to invoices" class="flex size-8 items-center justify-center rounded-lg border border-border bg-card text-muted-foreground transition-all hover:bg-accent hover:text-foreground shadow-sm shrink-0" href="/invoices"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left size-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></a><h1 class="text-2xl font-bold tracking-tight font-heading text-foreground whitespace-nowrap">New Invoice</h1></div><form class="flex flex-col gap-3.5"><input type="hidden" name="gst_rate_type"/><div class="grid gap-3.5 lg:grid-cols-12"><div class="rounded-xl border border-border bg-card px-4 py-3.5 shadow-sm lg:col-span-7"><div class="flex items-center gap-2 mb-2 pb-1.5 border-b border-border"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-pen lucide-clipboard-edit size-4 text-primary shrink-0" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v2"></path><path d="M21.34 15.664a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"></path><path d="M8 22H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1"></rect></svg><span class="text-sm font-bold text-foreground uppercase tracking-wider whitespace-nowrap">Invoice Info</span></div><div class="grid gap-3 sm:grid-cols-3 items-end"><div><label for="invoice-number-input" class="mb-1 block text-xs font-bold text-muted-foreground uppercase tracking-wider whitespace-nowrap">Invoice Number</label><div class="relative"><input id="invoice-number-input" aria-label="Invoice number (assigned on finalize)" type="text" readOnly="" class="w-full rounded-lg border border-border px-3 py-1.5 placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-all hover:border-muted-foreground/30 shadow-sm pr-16 font-mono text-xs text-muted-foreground bg-muted/50 border-dashed" value="DRAFT"/><span class="absolute right-2 top-1/2 -translate-y-1/2 rounded bg-success-subtle px-1.5 py-0.5 text-[10px] font-bold text-success-text border border-success/20 whitespace-nowrap">AUTO</span></div><p class="mt-1 text-xs text-muted-foreground whitespace-nowrap truncate">Will lock to a formal series on finalize</p></div><div><label for="invoice-date-input" class="mb-1 block text-xs font-bold text-muted-foreground uppercase tracking-wider whitespace-nowrap">Invoice Date</label><div class="relative"><input id="invoice-date-input" aria-label="Invoice date" type="date" class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-all hover:border-muted-foreground/30 shadow-sm pr-10" name="invoice_date"/><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none size-4 text-muted-foreground" aria-hidden="true"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path></svg></div><p class="mt-1 text-xs text-muted-foreground whitespace-nowrap truncate">Select the legal date of this invoice</p></div><div><label class="mb-1 block text-xs font-bold text-muted-foreground uppercase tracking-wider whitespace-nowrap">Print Preview</label><button id="draft-preview-btn" type="button" class="flex w-full items-center justify-center gap-2 px-3 py-1.5 border rounded-lg text-sm font-semibold transition-all h-[34px] shadow-sm whitespace-nowrap border-input bg-background hover:bg-accent text-foreground hover:text-accent-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4 shrink-0" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg> <span>Preview Invoice</span></button><p class="mt-1 text-xs text-muted-foreground whitespace-nowrap truncate">Verification check required</p></div></div></div><div class="rounded-xl border border-border bg-card px-4 py-3.5 shadow-sm lg:col-span-5"><div class="flex items-center gap-2 mb-2 pb-1.5 border-b border-border"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user size-4 text-primary shrink-0" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg><span class="text-sm font-bold text-foreground uppercase tracking-wider whitespace-nowrap">Customer Details</span></div><div class="flex flex-col gap-3"><div class="relative"><label for="customer-name-input" class="mb-1 block text-xs font-bold text-muted-foreground uppercase tracking-wider whitespace-nowrap">Customer Name</label><input id="customer-name-input" type="text" placeholder="Type to search or enter ad-hoc name..." class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-all hover:border-muted-foreground/30 shadow-sm" name="billing_name"/></div><div class="grid gap-3 sm:grid-cols-2"><div><label for="billing-gstin-input" class="mb-1 block text-xs font-bold text-muted-foreground uppercase tracking-wider whitespace-nowrap">GSTIN (Optional)</label><input id="billing-gstin-input" type="text" placeholder="e.g. 29ABCDE1234F1Z5" class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-all hover:border-muted-foreground/30 shadow-sm font-mono text-xs uppercase" name="billing_gstin"/></div><div><label for="place-of-supply-input" class="mb-1 block text-xs font-bold text-muted-foreground uppercase tracking-wider whitespace-nowrap">Place of Supply State</label><div class="relative"><select id="place-of-supply-input" aria-label="Place of supply state" class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-all hover:border-muted-foreground/30 shadow-sm appearance-none pr-9" name="place_of_supply_state_code"><option value="01">01 - Jammu and Kashmir</option><option value="02">02 - Himachal Pradesh</option><option value="03">03 - Punjab</option><option value="04">04 - Chandigarh</option><option value="05">05 - Uttarakhand</option><option value="06">06 - Haryana</option><option value="07">07 - Delhi</option><option value="08">08 - Rajasthan</option><option value="09">09 - Uttar Pradesh</option><option value="10">10 - Bihar</option><option value="11">11 - Sikkim</option><option value="12">12 - Arunachal Pradesh</option><option value="13">13 - Nagaland</option><option value="14">14 - Manipur</option><option value="15">15 - Mizoram</option><option value="16">16 - Tripura</option><option value="17">17 - Meghalaya</option><option value="18">18 - Assam</option><option value="19">19 - West Bengal</option><option value="20">20 - Jharkhand</option><option value="21">21 - Odisha</option><option value="22">22 - Chhattisgarh</option><option value="23">23 - Madhya Pradesh</option><option value="24">24 - Gujarat</option><option value="26">26 - Dadra and Nagar Haveli and Daman and Diu</option><option value="27">27 - Maharashtra</option><option value="29">29 - Karnataka</option><option value="30">30 - Goa</option><option value="31">31 - Lakshadweep</option><option value="32">32 - Kerala</option><option value="33">33 - Tamil Nadu</option><option value="34">34 - Puducherry</option><option value="35">35 - Andaman and Nicobar Islands</option><option value="36">36 - Telangana</option><option value="37">37 - Andhra Pradesh</option><option value="38">38 - Ladakh</option></select><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none size-4 text-muted-foreground" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></div></div></div></div></div></div><div class="rounded-xl border border-border bg-card px-4 py-3.5 shadow-sm"><div class="mb-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border pb-2"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-todo size-4 text-primary" aria-hidden="true"><path d="M13 5h8"></path><path d="M13 12h8"></path><path d="M13 19h8"></path><path d="m3 17 2 2 4-4"></path><rect x="3" y="4" width="6" height="6" rx="1"></rect></svg><span class="text-sm font-bold text-foreground uppercase tracking-wider">Invoice Line Items</span></div><p class="text-xs text-muted-foreground">GST is calculated automatically in the estimate below</p></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-border bg-muted/10"><th class="pl-1 pr-0 py-1.5" style="width:36px;min-width:36px;text-align:left" aria-label="Reorder"></th><th class="pl-3 pr-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-left whitespace-nowrap" style="width:42px;min-width:42px;text-align:left">S.No</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-left whitespace-nowrap" style="width:100%;min-width:250px">Description</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center whitespace-nowrap" style="width:76px;min-width:76px;text-align:center">HSN/SAC</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center whitespace-nowrap" style="width:64px;min-width:64px;text-align:center">Qty</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center whitespace-nowrap" style="width:72px;min-width:72px;text-align:center">UQC</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center select-none whitespace-nowrap" style="width:125px;min-width:125px;text-align:right"><div class="flex items-center justify-end gap-1 cursor-help whitespace-nowrap" title="Prices entered are exclusive of GST. Tax will be added on top of this rate during calculations."><span class="whitespace-nowrap">Rate (GST Excl)</span><span class="text-xs text-muted-foreground font-bold font-sans flex items-center justify-center border border-muted-foreground/30 rounded-full size-3.5 select-none transition-colors hover:border-primary hover:text-primary">i</span></div></th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center whitespace-nowrap" style="width:64px;min-width:64px;text-align:right">Disc (%)</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center whitespace-nowrap" style="width:80px;min-width:80px;text-align:center">GST Rate</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center whitespace-nowrap" style="width:100px;min-width:100px;text-align:right">Net Amount</th><th class="px-2 py-1.5 text-xs font-bold text-muted-foreground uppercase tracking-wider text-center whitespace-nowrap" style="width:40px;min-width:40px;text-align:center"></th></tr></thead><tbody class="divide-y divide-border/60"><tr data-row-index="0" class="group transition-colors relative hover:bg-muted/5"><td class="pl-1 pr-0 py-1.5 align-middle" style="width:36px;min-width:36px;text-align:left"><div id="reorder-line-1" role="button" tabindex="-1" aria-disabled="true" aria-label="Reorder line 1" draggable="false" class="flex h-9 w-8 items-center justify-center rounded-md transition-all select-none touch-none focus:outline-none focus-visible:ring-2 focus-visible:ring-ring opacity-20 cursor-default"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-grip-vertical size-4" aria-hidden="true"><circle cx="9" cy="12" r="1"></circle><circle cx="9" cy="5" r="1"></circle><circle cx="9" cy="19" r="1"></circle><circle cx="15" cy="12" r="1"></circle><circle cx="15" cy="5" r="1"></circle><circle cx="15" cy="19" r="1"></circle></svg></div></td><td class="pl-3 pr-2 py-1.5 text-xs font-mono text-muted-foreground text-left" style="width:42px;min-width:42px;text-align:left">001</td><td class="px-2 py-1.5 relative" style="width:100%;min-width:250px"><input type="text" placeholder="Description" aria-label="Description, line 1" class="w-full round