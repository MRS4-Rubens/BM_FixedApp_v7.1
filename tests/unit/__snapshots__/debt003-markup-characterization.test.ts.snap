exports[`DEBT-003 Markup Characterization Snapshot > CheckoutForm (e) initialCycle yearly 1`] = `"<div class="grid gap-5 sm:gap-6 lg:grid-cols-12 w-full"><div class="lg:col-span-8 space-y-4"><div class="flex items-center gap-3 rounded-2xl border border-amber-200 bg-amber-50 py-2.5 px-3.5 text-amber-800 shadow-xs"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock size-5 shrink-0 text-amber-500" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><div><b class="text-sm font-bold block">Free Trial Active (15 Days Left)</b><span class="text-xs mt-0.5 block text-amber-700">Upgrade to Essentials now to lock in continuous access and avoid feature interruption.</span></div></div><div class="rounded-2xl border border-slate-200/80 bg-white p-4.5 sm:p-5 shadow-xs"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3"><div><div class="flex items-center gap-2"><span class="flex size-6 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-bold">1</span><h2 class="text-lg font-extrabold text-slate-900 font-heading tracking-tight">Select Your Subscription Tier</h2></div><p class="text-sm text-slate-500 mt-1 ml-8">Choose the plan that matches your business throughput.</p></div><div class="flex items-center bg-slate-100 p-1 rounded-xl w-fit self-start sm:self-auto"><button type="button" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all cursor-pointer text-slate-600 hover:text-slate-900">Monthly</button><button type="button" class="px-3.5 py-1.5 rounded-lg text-sm transition-all cursor-pointer flex items-center gap-1.5 bg-white text-slate-900 shadow-xs font-bold"><span>Yearly</span><span class="bg-emerald-100 border border-emerald-200 text-emerald-800 px-1.5 py-0.5 rounded text-xs font-extrabold">SAVE 27%</span></button></div></div><div class="mt-3 flex items-center gap-2 rounded-xl bg-emerald-50 border border-emerald-200 px-3.5 py-2 text-sm font-semibold text-emerald-900 shadow-2xs"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars size-4 text-emerald-600 shrink-0" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg><span>You are saving <strong>₹1,289.00</strong> per year with annual billing (includes 2 months free)!</span></div><div class="mt-3.5 grid gap-4 sm:grid-cols-2"><button type="button" class="flex flex-col justify-between text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all relative overflow-hidden border-indigo-600 ring-2 ring-indigo-500/10 shadow-md bg-gradient-to-b from-white to-indigo-50/30 cursor-pointer"><div class="w-full"><div class="flex justify-between items-center w-full mb-1"><span class="text-sm font-bold uppercase tracking-wider text-slate-500">Essentials Pro</span><span class="rounded-full bg-amber-50 border border-amber-200 text-amber-800 px-2.5 py-0.5 text-xs font-extrabold shadow-2xs">Most Popular</span></div><p class="text-xs text-slate-500 leading-snug mb-1.5">For growing retailers, wholesalers and traders</p><div class="flex items-baseline gap-1"><span class="text-4xl font-black font-heading text-slate-900">₹3,499.00</span><span class="text-sm text-slate-500 font-semibold">/ year</span></div></div><div class="mt-2.5 border-t border-dashed border-slate-200 pt-2 w-full space-y-1.5"><ul class="space-y-1"><li clas